<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ScribePro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tvModeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloud"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        android:background="@color/surface_container_low"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable main content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Waveform panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#14ffffff"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/llWaveformBars"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|center_horizontal"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvWaveformStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready to transcribe"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mic button with pulse rings -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/vPulseRing"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0" />

                <View
                    android:id="@+id/vPulseRing2"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Start transcription"
                    app:backgroundTint="@color/inverse_primary"
                    app:tint="@color/primary_fixed"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FullCircle"
                    app:fabCustomSize="84dp"
                    app:maxImageSize="36dp" />
            </FrameLayout>

            <!-- Hero title + subtitle -->
            <TextView
                android:id="@+id/tvRecordingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Recording"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvRecordingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to capture and transcribe audio"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:letterSpacing="0.005"
                android:layout_marginBottom="20dp" />

            <!-- Language + Mode chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="@color/on_surface"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp"
                    app:chipIconVisible="false"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Cloud"
                    android:textColor="@color/primary"
                    app:chipBackgroundColor="@color/primary_container"
                    app:chipStrokeWidth="0dp"
                    app:chipIconVisible="false"
                    app:checkedIconVisible="false" />

            </LinearLayout>

            <!-- Setup issue card (hidden when everything is set up) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSetupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSetupMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSetupAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fix"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Activity header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Activity"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:letterSpacing="-0.01" />

                <Button
                    android:id="@+id/btnViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="@color/primary"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <!-- No transcripts placeholder -->
            <TextView
                android:id="@+id/tvNoRecents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No transcriptions yet.\nTap the mic button to start."
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:lineSpacingMultiplier="1.5"
                android:visibility="visible" />

            <!-- Horizontal recent transcripts list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentTranscripts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
